# -----------------------------------------------------------------
# Pushpaka v1.0.0 - Environment Variables
# Copy this file to .env and fill in your values.
# -----------------------------------------------------------------

# -- Application --------------------------------------------------
APP_ENV=production           # development | production
LOG_LEVEL=info               # debug | info | warn | error
BASE_URL=http://localhost:8080    # Public URL of the API (used for OAuth redirect URIs)

# -- Domain (for Traefik routing + Let's Encrypt) -----------------
DOMAIN=pushpaka.example.com          # Your base domain
ACME_EMAIL=admin@example.com         # Let's Encrypt registration email

# ----- Multi-Database Support ---------------------------------------
DATABASE_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=pushpaka
DB_PASSWORD=pushpaka
DB_NAME=pushpaka

# SSL/TLS Configuration for PostgreSQL
DB_SSL_MODE=disable
DB_SSL_CERT_FILE=

# Connection pool tuning
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=3
DB_CONN_MAX_LIFETIME=15m

# ----- Redis Cache & Queue -------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=5
REDIS_MIN_IDLE_CONNS=1
REDIS_MAX_CONN_AGE=10m
REDIS_POOL_TIMEOUT=4s
REDIS_IDLE_TIMEOUT=5m
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# -- JWT ----------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string_minimum_32_chars
JWT_EXPIRY_HOURS=24

# -- CORS (comma-separated for multiple origins) ------------------
CORS_ORIGINS=https://app.pushpaka.example.com

# ----- BUILD DIRECTORIES ---------------------------------------------------
BUILDS_DIR=/tmp/builds/pushpaka
PROJECTS_DIR=/tmp/projects/pushpaka
DEPLOYS_DIR=/tmp/deploys/pushpaka
TESTS_DIR=/tmp/tests/pushpaka

# Number of concurrent build workers
BUILD_WORKERS=3
AI_WORKERS=2
SYNC_WORKERS=4
TEST_WORKER=2
COMMIT_LIMIT=3

# -- Component selection (unified binary) -------------------------
PUSHPAKA_COMPONENT=all

# -- Traefik Dashboard Auth ---------------------------------------
TRAEFIK_AUTH=admin:$$apr1$$ruca84Hq$$mbjdMZBAG.KWn7XvjLOCl/

# ================================================================
# RBAC & USER MANAGEMENT (NEW in v1.0.0)
# ================================================================

# Auto-promote this email to admin role on registration (or on first login via OAuth).
# Leave blank to auto-promote only the FIRST registered user.
FIRST_ADMIN_EMAIL=

# ================================================================
# SSO / OAUTH  (NEW: GitLab support + org restrictions)
# ================================================================

# GitHub OAuth (SSO login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: restrict GitHub login to users in these orgs (comma-separated)
# Leave empty to allow any GitHub user
GITHUB_ALLOWED_ORGS=

# GitLab OAuth (SSO login)
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Override for self-hosted GitLab (default: https://gitlab.com)
GITLAB_BASE_URL=https://gitlab.com
# Optional: restrict GitLab login to users in these groups (comma-separated)
GITLAB_ALLOWED_GROUPS=

# Frontend redirect URL after successful OAuth (should be your frontend URL + /login)
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/login

# ================================================================
# RATE LIMITING
# ================================================================

# Per-IP rate limits (requests per minute, 0 = disabled)
RATE_LIMIT_AUTH=20          # Auth endpoints (login, register) — lower to prevent brute-force
RATE_LIMIT_API=200          # General API endpoints
RATE_LIMIT_DEPLOY=10        # Deployment trigger endpoint — prevents queue flooding

# ================================================================
# AI MONITORING  
# ================================================================

# Minutes before a "building" deployment triggers a stuck-build alert (default: 30)
AI_STUCK_BUILD_THRESHOLD_MINUTES=30

# ================================================================
# PORT ALLOCATION (for non-Docker deployments)
# ================================================================

# Port range for dynamically allocated deployment ports
PORT_RANGE_START=10000
PORT_RANGE_END=19999

# ================================================================
# NOTIFICATIONS
# ================================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@pushpaka.example.com